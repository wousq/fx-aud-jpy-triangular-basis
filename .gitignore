# ---- vendor data: large, and redistributable only from the vendor ----
data/raw/**
!data/raw/.gitkeep

data/**/*.parquet
!data/README.md

# ---- generated output ----
#
# Tables and figures ARE committed. The README cites them by name, and a
# reader who never runs the pipeline should still be able to open them.
# 212 KB across 46 tables and 1.5 MB across 15 figures.
#
output/data/*
!output/data/.gitkeep

# The data-quality stamp the Makefile writes.
output/.quality-ok

# ---- latex build artefacts ----
report/**/*.aux
report/**/*.log
report/**/*.out
report/**/*.bbl
report/**/*.blg
report/**/*.fls
report/**/*.fdb_latexmk
report/**/*.synctex.gz
report/**/*.toc

# report/main.pdf is deliberately NOT ignored

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# ---- editor / os ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini